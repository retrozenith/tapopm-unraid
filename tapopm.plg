<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "tapopm">
<!ENTITY author    "Flroain Victor (retrozenith)">
<!ENTITY version   "2025.12.07">
<!ENTITY launch    "Settings/TapoPMSettings">
<!ENTITY gitURL    "https://raw.githubusercontent.com/retrozenith/tapopm-unraid/main">
  <INLINE>
   echo "Removing &name;..."
   removepkg &plgPATH;/*.txz
   rm -rf &plgPATH;
   rm -rf &emhttp;
   echo "&name; has been removed"
  </INLINE>
 </FILE>
</PLUGIN>
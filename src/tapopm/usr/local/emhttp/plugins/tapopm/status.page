<script>
const tapopm_status = () => {
    $.getJSON("/plugins/tapopm/status.php", (data) => {
        if (data) {
            $(".tapopm-energy-power").html(data.Power);
            $(".tapopm-energy-today").html(data.Today);
            $(".tapopm-energy-yesterday").html(data.Yesterday);
            $(".tapopm-energy-total").html(data.Total);
            $(".tapopm-energy-voltage").html(data.Voltage);
            $(".tapopm-energy-current").html(data.Current);
            $(".tapopm-energy-apparentpower").html(data.ApparentPower);
            $(".tapopm-energy-reactivepower").html(data.ReactivePower);
            $(".tapopm-energy-efficiency").html((Number.parseFloat(data.Factor) * 100).toFixed());
            $(".tapopm-costs_today").html((Number.parseFloat(data.Costs_Price) * Number.parseFloat(data.Today)).toFixed(2));
            $(".tapopm-costs_yesterday").html((Number.parseFloat(data.Costs_Price) * Number.parseFloat(data.Yesterday)).toFixed(2));
            $(".tapopm-costs_total").html((Number.parseFloat(data.Costs_Price) * Number.parseFloat(data.Total)).toFixed(2));
            $(".tapopm-costs_unit").html(data.Costs_Unit);
        }
    });
};
$(tapopm_status);
if (<?=$tapopm_cfg['UIREFRESH'];?>) {
    setInterval(tapopm_status, <?=$tapopm_cfg['UIREFRESH'];?>);
}
$(function() {
  // append data from the table into the correct one
  $("#db-box1").append($(".dash_tapopm").html());
  
  // reload toggle to get the correct state
  toggleView('tapopm_view',true);
  
  // reload sorting to get the stored data (cookie)
  sortTable($('#db-box1'),$.cookie('db-box1'));
});
</script>